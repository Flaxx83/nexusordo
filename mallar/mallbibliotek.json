      "id": "scrum",
      "name": "Scrum",
      "agile": true,
      "anchor": "START",
      "description": "Sprint 0 (set-up), then N sprints with Sprint Planning, Sprint Review and Sprint Retrospective (the Daily Scrum is not shown in the timeline). A release every X sprints and the Product Goal as a gate. The sprint content can be kept as a checklist on Sprint Backlog.",
      "source": "Scrum Guide 2020 (Schwaber & Sutherland, CC BY-SA 4.0) – terms only, no text",
      "phases": [
        {
          "name": "Sprint 0"
        },
        {
          "name": "Sprint {n}",
          "repeat": true
        },
        {
          "name": "Releases"
        }
      ],
      "items": [
        {
          "name": "Product Backlog",
          "phase": "Sprint 0",
          "anchor": "START",
          "endW": 0,
          "durW": 1,
          "order": 1
        },
        {
          "name": "Definition of Done",
          "phase": "Sprint 0",
          "anchor": "START",
          "endW": 0,
          "durW": 0,
          "milestone": true,
          "order": 2,
          "after": [
            "Product Backlog"
          ]
        },
        {
          "name": "Product Goal",
          "phase": "Releases",
          "anchor": "END",
          "endW": 0,
          "durW": 0,
          "milestone": true,
          "gateMs": true,
          "order": 3,
          "after": [
            "last:Sprint Review"
          ]
        }
      ],
      "repeat": {
        "name": "Sprint {n}",
        "unit": "sprint",
        "count": 6,
